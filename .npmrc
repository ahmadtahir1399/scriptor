# openai@4 declares zod@^3 as an *optional* peer (only for its zod helper utils,
# which this project does not use — we validate with our own zod@4). npm otherwise
# refuses the install over that optional-peer mismatch. Accept it project-wide so
# `npm install` works without flags in the container, on a fresh machine, and in CI.
legacy-peer-deps=true
